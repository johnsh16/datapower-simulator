{
  "name": "gws-sim",
  "version": "0.1.0",
  "description": "DataPower GatewayScript simulator for Node.js with mockable urlopen",
  "main": "index.js",
  "scripts": {
    "test": "node bin/gws-test.js test/*.test.js",
    "example": "node examples/run-example.js",
    "test:walkthrough": "node bin/gws-test.js examples/walkthrough/greet.test.js examples/walkthrough/greet.helpers.test.js",
    "new-test": "node bin/gws-new-test.js"
  },
  "keywords": [
    "datapower",
    "gatewayscript",
    "mock",
    "urlopen"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "xpath": "^0.0.36"
  },
  "bin": {
    "gws-run": "bin/gws-run.js",
    "gws-new-test": "bin/gws-new-test.js",
    "gws-test": "bin/gws-test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
